{
  "name": "trashbot",
  "version": "1.0.0",
  "description": "Discord bot with YouTube music, TTS, and AI image generation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy-commands": "tsx src/deploy-commands.ts",
