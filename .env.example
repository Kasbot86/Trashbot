# Required: Bot token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Required: Application (client) ID from Discord Developer Portal
CLIENT_ID=your_client_id_here

# Optional: Guild ID for faster guild-scoped command deploy during development
# Leave empty to deploy globally (can take up to 1 hour to propagate)
GUILD_ID=

# Optional: OpenAI API key for DALL-E image generation (falls back to Pollinations.ai)
OPENAI_API_KEY=
